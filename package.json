{
  "name": "show-merge-base",
  "displayName": "VS Code Show Merge Base",
  "publisher": "KyleRamirez",
  "repository": "https://github.com/kyleramirez/vscode-show-merge-base",
  "version": "0.0.0",
  "engines": {
    "vscode": "^1.98.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Show Merge Base",
      "properties": {
        "showMergeBase.baseBranch": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optionally set the base or parent branch for comparison (defaults to parent branch)"
        }
      }
    },
    "commands": [
      {
        "command": "showMergeBase.changeBaseBranch",
        "title": "Show Merge Base: change base branch ..."
      },
      {
        "command": "showMergeBase.showOppositeMergeDirection",
        "title": "Show Merge Base: show opposite merge direction ..."
      }
    ],
    "colors": [
      {
        "id": "showMergeBase.changedResourceForeground",
        "description": "changed",
        "defaults": {
          "light": "gitDecoration.changedResourceForeground",
          "dark": "gitDecoration.changedResourceForeground",
          "highContrast": "gitDecoration.changedResourceForeground"
        }
      },
      {
        "id": "showMergeBase.addedResourceForeground",
        "description": "added",
        "defaults": {
          "light": "gitDecoration.untrackedResourceForeground",
          "dark": "gitDecoration.untrackedResourceForeground",
          "highContrast": "gitDecoration.untrackedResourceForeground"
        }
      },
      {
        "id": "showMergeBase.deletedResourceForeground",
        "description": "deleted",
        "defaults": {
          "light": "gitDecoration.deletedResourceForeground",
          "dark": "gitDecoration.deletedResourceForeground",
          "highContrast": "gitDecoration.deletedResourceForeground"
        }
      }
    ]
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "scripts": {
    "vscode:prepublish": "pnpm compile",
    "compile": "tsc -p .",
    "watch": "pnpm compile -w",
    "host:code": "node --trace-warnings ./scripts/host.js code",
    "host:cursor": "node --trace-warnings ./scripts/host.js cursor",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.98.0",
    "@vscode/vsce": "^3.7.0",
    "typescript": "^5.9.3"
  }
}
