{
  "name": "merge-base",
  "displayName": "VS Code Merge Base",
  "publisher": "KyleRamirez",
  "repository": "https://github.com/kyleramirez/vscode-merge-base",
  "version": "0.0.0",
  "engines": {
    "vscode": "^1.98.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Merge Base",
      "properties": {
        "mergeBase.baseBranch": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optionally set the base or parent branch for comparison (defaults to parent branch)"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "mergeBase.changeBaseBranch",
          "group": "navigation"
        },
        {
          "command": "mergeBase.showOppositeMergeDirection",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "mergeBase.changeBaseBranch",
          "when": "scmProvider == git"
        },
        {
          "command": "mergeBase.showOppositeMergeDirection",
          "when": "scmProvider == git"
        }
      ],
      "commandPalette": [
        {
          "command": "mergeBase.changeBaseBranch"
        },
        {
          "command": "mergeBase.showOppositeMergeDirection"
        }
      ]
    },
    "commands": [
      {
        "command": "mergeBase.changeBaseBranch",
        "title": "Merge Base: choose base branch"
      },
      {
        "command": "mergeBase.showOppositeMergeDirection",
        "title": "Merge Base: switch merge direction"
      },
      {
        "command": "mergeBase.toggle",
        "title": "Merge Base: toggle show"
      }
    ],
    "colors": [
      {
        "id": "mergeBase.changedResourceForeground",
        "description": "changed",
        "defaults": {
          "light": "gitDecoration.changedResourceForeground",
          "dark": "gitDecoration.changedResourceForeground",
          "highContrast": "gitDecoration.changedResourceForeground"
        }
      },
      {
        "id": "mergeBase.addedResourceForeground",
        "description": "added",
        "defaults": {
          "light": "gitDecoration.untrackedResourceForeground",
          "dark": "gitDecoration.untrackedResourceForeground",
          "highContrast": "gitDecoration.untrackedResourceForeground"
        }
      },
      {
        "id": "mergeBase.deletedResourceForeground",
        "description": "deleted",
        "defaults": {
          "light": "gitDecoration.deletedResourceForeground",
          "dark": "gitDecoration.deletedResourceForeground",
          "highContrast": "gitDecoration.deletedResourceForeground"
        }
      }
    ]
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "scripts": {
    "vscode:prepublish": "pnpm compile",
    "compile": "tsc -p .",
    "watch": "pnpm compile -w",
    "host:code": "node --trace-warnings ./scripts/host.js code",
    "host:cursor": "node --trace-warnings ./scripts/host.js cursor",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.98.0",
    "@vscode/vsce": "^3.7.0",
    "typescript": "^5.9.3"
  }
}
