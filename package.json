{
  "name": "show-merge-base",
  "displayName": "VS Code Show Merge Base",
  "publisher": "KyleRamirez",
  "repository": "https://github.com/kyleramirez/vscode-show-merge-base",
  "version": "0.0.0",
  "engines": {
    "vscode": "^1.98.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Show Merge Base",
      "properties": {
        "showMergeBase.mergeBase": {
          "type": "string",
          "default": "",
          "description": "Base / parent branch to compare against. Leave empty to auto-detect the upstream branch."
        },
        "showMergeBase.includeUntracked": {
          "type": "boolean",
          "default": true,
          "description": "Highlight untracked files too."
        }
      }
    },
    "commands": [
      {
        "command": "showMergeBase.refresh",
        "title": "Show Merge Base: Refresh"
      }
    ],
    "colors": [
      {
        "id": "showMergeBase.modifiedResourceForeground",
        "description": "Current branch modified file",
        "defaults": {
          "light": "gitDecoration.modifiedResourceForeground",
          "dark": "gitDecoration.modifiedResourceForeground",
          "highContrast": "gitDecoration.modifiedResourceForeground"
        }
      },
      {
        "id": "showMergeBase.addedResourceForeground",
        "description": "Current branch added file",
        "defaults": {
          "light": "gitDecoration.untrackedResourceForeground",
          "dark": "gitDecoration.untrackedResourceForeground",
          "highContrast": "gitDecoration.untrackedResourceForeground"
        }
      },
      {
        "id": "showMergeBase.unknownForeground",
        "description": "Unknown file state",
        "defaults": {
          "light": "gitDecoration.conflictingResourceForeground",
          "dark": "gitDecoration.conflictingResourceForeground",
          "highContrast": "gitDecoration.conflictingResourceForeground"
        }
      }
    ]
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "scripts": {
    "vscode:prepublish": "pnpm compile",
    "compile": "tsc -p .",
    "watch": "pnpm compile -w",
    "host:code": "node --trace-warnings ./scripts/host.js code",
    "host:cursor": "node --trace-warnings ./scripts/host.js cursor",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.98.0",
    "@vscode/vsce": "^3.7.0",
    "typescript": "^5.9.3"
  }
}
